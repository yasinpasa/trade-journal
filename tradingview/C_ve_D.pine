//@version=6
// C + D birleşik strateji — EURUSD H1, sadece hafta içi. İki kural zamanda çakışmaz.
// D: Londra 12:00 mumu açılışında SAT, mum kapanışında (13:00) çık. SL 30 pip (güvenlik).
// C: Londra 13:00 mumu son 20 günün ortanca boyundan küçük/eşitse mumun TERSİNE gir (13:00 mum kapanışı),
//    SL 30 / TP 30, en geç 3 mum sonra kapanışla çık.
// Python testi 2020-09 → 2025-09 (maliyet 0,7 pip): C 647 işlem +1,88 · D 1302 işlem +0,78 · birlikte 1949 işlem +1,14, t 3,39.
strategy("C + D Kurali", overlay = true,
     process_orders_on_close = true, calc_on_every_tick = false,
     initial_capital = 10000, currency = currency.USD,
     default_qty_type = strategy.fixed, default_qty_value = 10000,
     commission_type = strategy.commission.cash_per_order, commission_value = 0.35,
     margin_long = 1, margin_short = 1)   // %1 teminat (1:100); yoksa 0,1 lot 10.000$ hesaba sığmaz

cAcik    = input.bool(true, "C kuralı açık")
dAcik    = input.bool(true, "D kuralı açık")
cSaat    = input.int(13, "C sinyal mumu (Londra)")
dSaat    = input.int(12, "D mumu (Londra)", tooltip = "Plasebo için başka saat dene")
gun      = input.int(20, "C ortanca gün sayısı", minval = 5)
slPip    = input.float(30, "SL (pip, iki kural)")
tpPip    = input.float(30, "C TP (pip)")
tutus    = input.int(3, "C en geç kaç mum", minval = 1)
maliyet  = input.float(0.7, "Tablo için maliyet (pip/işlem)")
bas      = input.time(timestamp("2020-09-21T00:00:00"), "Başlangıç")
bit      = input.time(timestamp("2099-01-01T00:00:00"), "Bitiş")

if timeframe.period != "60"
    runtime.error("Bu strateji sadece 1 saatlik (H1) grafikte çalışır.")

pip      = syminfo.mintick < 0.001 ? 0.0001 : 0.01
lh       = hour(time, "Europe/London")
ldow     = dayofweek(time, "Europe/London")
haftaIci = ldow >= dayofweek.monday and ldow <= dayofweek.friday
tarihte  = time >= bas and time <= bit

// ---------- D: bir önceki mumun kapanışında gir (= D mumunun açılışı), D mumunun kapanışında çık
dOnceki = (dSaat + 23) % 24
dGir = dAcik and tarihte and haftaIci and lh == dOnceki and strategy.position_size == 0
if dGir
    strategy.entry("D SAT", strategy.short)
    strategy.exit("D SL", "D SAT", stop = close + slPip * pip)
if lh == dSaat
    strategy.close("D SAT", comment = "D süre")

// ---------- C
sinyalMumu = lh == cSaat and haftaIci
var array<float> boylar = array.new<float>()
boy = (high - low) / pip
float ortanca = na
bool kucuk = false
if sinyalMumu
    n = array.size(boylar)
    if n >= gun
        ortanca := array.median(array.slice(boylar, n - gun, n))
        kucuk := boy <= ortanca
    array.push(boylar, boy)
    if array.size(boylar) > 500
        array.shift(boylar)

yon = cAcik and kucuk and close != open ? (close > open ? -1 : 1) : 0
var int girisBar = na
if yon != 0 and tarihte and strategy.position_size == 0
    if yon > 0
        strategy.entry("C AL", strategy.long)
        strategy.exit("C AL çıkış", "C AL", stop = close - slPip * pip, limit = close + tpPip * pip)
    else
        strategy.entry("C SAT", strategy.short)
        strategy.exit("C SAT çıkış", "C SAT", stop = close + slPip * pip, limit = close - tpPip * pip)
    girisBar := bar_index

if not na(girisBar) and bar_index - girisBar >= tutus
    strategy.close("C AL", comment = "C süre")
    strategy.close("C SAT", comment = "C süre")
    girisBar := na

// ---------- Pip istatistiği (Python testiyle aynı ölçü: net pip/işlem), kural kural
var float cTop = 0.0
var float dTop = 0.0
var int cN = 0
var int dN = 0
var int cK = 0
var int dK = 0
var int sonKapanan = 0
if strategy.closedtrades > sonKapanan
    for k = sonKapanan to strategy.closedtrades - 1
        e = strategy.closedtrades.entry_price(k)
        x = strategy.closedtrades.exit_price(k)
        s = strategy.closedtrades.size(k)
        p = (x - e) / pip * math.sign(s) - maliyet
        if str.startswith(strategy.closedtrades.entry_id(k), "D")
            dTop += p
            dN += 1
            dK += p > 0 ? 1 : 0
        else
            cTop += p
            cN += 1
            cK += p > 0 ? 1 : 0
    sonKapanan := strategy.closedtrades

// ---------- Görsel
bgcolor(dAcik and lh == dSaat and haftaIci ? color.new(color.orange, 88) : na, title = "D mumu")
plotshape(yon > 0, "C AL", shape.triangleup, location.belowbar, color.new(color.blue, 0), size = size.small)
plotshape(yon < 0, "C SAT", shape.triangledown, location.abovebar, color.new(color.red, 0), size = size.small)

f(top, n) => n > 0 ? str.tostring(top / n, "#.##") : "-"
w(k, n) => n > 0 ? str.tostring(100.0 * k / n, "#") + "%" : "-"
var table tb = table.new(position.top_right, 4, 5, bgcolor = color.new(color.black, 15), border_width = 1)
if barstate.islast
    table.cell(tb, 0, 0, "", text_color = color.white)
    table.cell(tb, 1, 0, "C", text_color = color.white)
    table.cell(tb, 2, 0, "D", text_color = color.white)
    table.cell(tb, 3, 0, "Toplam", text_color = color.white)
    table.cell(tb, 0, 1, "İşlem", text_color = color.white)
    table.cell(tb, 1, 1, str.tostring(cN), text_color = color.white)
    table.cell(tb, 2, 1, str.tostring(dN), text_color = color.white)
    table.cell(tb, 3, 1, str.tostring(cN + dN), text_color = color.white)
    table.cell(tb, 0, 2, "Net ort (pip)", text_color = color.white)
    table.cell(tb, 1, 2, f(cTop, cN), text_color = color.white)
    table.cell(tb, 2, 2, f(dTop, dN), text_color = color.white)
    table.cell(tb, 3, 2, f(cTop + dTop, cN + dN), text_color = color.white)
    table.cell(tb, 0, 3, "Kazanan", text_color = color.white)
    table.cell(tb, 1, 3, w(cK, cN), text_color = color.white)
    table.cell(tb, 2, 3, w(dK, dN), text_color = color.white)
    table.cell(tb, 3, 3, w(cK + dK, cN + dN), text_color = color.white)
    table.cell(tb, 0, 4, "Python ref", text_color = color.gray)
    table.cell(tb, 1, 4, "+1,88", text_color = color.gray)
    table.cell(tb, 2, 4, "+0,78", text_color = color.gray)
    table.cell(tb, 3, 4, "+1,14", text_color = color.gray)
